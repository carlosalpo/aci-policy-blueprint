{
  "applications": [
    {
      "epgs": [
        {
          "bridge_domain": "AppBD",
          "name": "App"
        },
        {
          "bridge_domain": "DatabaseBD",
          "name": "Database"
        },
        {
          "bridge_domain": "WebBD",
          "name": "Web"
        }
      ],
      "name": "Store"
    }
  ],
  "bridge_domains": [
    {
      "gateway": "192.0.2.65/26",
      "name": "AppBD",
      "vrf": "Production"
    },
    {
      "gateway": "192.0.2.129/26",
      "name": "DatabaseBD",
      "vrf": "Production"
    },
    {
      "gateway": "192.0.2.1/26",
      "name": "WebBD",
      "vrf": "Production"
    }
  ],
  "flows": [
    {
      "consumer": "Store/App",
      "destination_ports": [
        {
          "from": 53,
          "to": 53
        }
      ],
      "id": "app_dns",
      "protocol": "udp",
      "provider": "Store/Database"
    },
    {
      "consumer": "Store/App",
      "destination_ports": [
        {
          "from": 5432,
          "to": 5432
        }
      ],
      "id": "app_to_database",
      "protocol": "tcp",
      "provider": "Store/Database"
    },
    {
      "consumer": "Store/Web",
      "destination_ports": [
        {
          "from": 8443,
          "to": 8443
        }
      ],
      "id": "web_to_app",
      "protocol": "tcp",
      "provider": "Store/App"
    }
  ],
  "schema_version": 1,
  "tenant": "BlueprintDemo",
  "vrfs": [
    {
      "name": "Production"
    }
  ]
}
